{
  "name": "tinyhmacmd5",
  "version": "0.1.3",
  "description": "A tiny, fully compliant HMAC-MD5 implementation for JavaScript: browser.min.js is only 1051 bytes.",
  "author": "bddjr",
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "types": "main.d.ts",
  "browser": "browser.min.js",
  "files": [
    "main.js",
    "main.d.ts",
    "browser.min.js"
  ],
  "homepage": "https://bddjr.github.io/tinyhmacmd5/",
  "scripts": {
    "build": "tsc && node scripts/build.mjs && es-check es2021 --module --checkFeatures main.js browser.min.js",
    "build:unchanged": "node scripts/build-unchanged.mjs",
    "test": "pnpm build && pnpm test:only",
    "test:only": "node scripts/test.mjs",
    "test:unchanged": "pnpm build:unchanged && pnpm test:only",
    "prepublishOnly": "pnpm test:unchanged"
  },
  "keywords": [
    "md5",
    "hash",
    "hmac",
    "hmacmd5",
    "hmac-md5",
    "tiny",
    "hex",
    "crypto",
    "encryption",
    "cryptography",
    "blueimp",
    "blueimp-md5",
    "js-md5",
    "crypto-js",
    "javascript",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bddjr/tinyhmacmd5.git"
  },
  "devDependencies": {
    "es-check": "^9.6.4",
    "terser": "^5.49.0",
    "tinyhmacmd5": "link:",
    "typescript": "^7.0.2"
  }
}
